    "14"
   ],
   "lb": []
  },
  {
   "id": "gunsho08-gen-dainagon-0002",
   "pid": "1879502",
   "pages": [
    27
   ],
   "text": "弘徽殿女御十番歌合紅葉左たつねつる心のまゝにいりにけり紅葉の色のふかき山邊に右隣風吹はそこにくれなゐみちぬめりいかはかりなる山の紅葉そ鴈左しら雲に宿かりかれのきこゆるは旅の空よりゆけはなりけり右をとつれぬたひのなきかなかりかれの行かふ道も遙なれとも鹿左つまこひて秋の夜深く鳴鹿のこゑには人もいやはれらるゝ右いつ方と聞こそわかね小夜更てたちともしらぬ鹿の音なれは",
   "poems": [
    "15",
    "16",
    "17",
    "18",
    "19",
    "20"
   ],
   "lb": []
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "のとかにも見ゆる空かな雲晴ていることをそき秋の夜の月",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "おほ空に月の光のあかき夜は槇の板戶もさゝれさりけり",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "荻の葉に吹わけて行秋かせのまた誰里をおとろかすらん",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "秋ふかくなりゆくまゝに風の音の梢に高く吹も行哉",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "白露をゝきつるまゝに見渡せはぬきにぬきてもにたる玉哉",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "秋のゝはをるへき花もなかりけりこほれてちらん露のおしさに",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "見わたせははるかに見ゆる河霧の深き秋にもなりにけるかな",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "花見むとしめしかひなみ秋霧のあしたの原に立わたりぬる",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "花薄まねくはつれの物なれと行過かたき秋の野邊哉",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "さためなき風しふかすは花薄心となひくかたは見てまし",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "香のみこそまきれさりけれ初霜のあしたの原のしら菊の花",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "むはたまの黑かみなから年ふれは菊のあたりのなつかしき哉",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "早苗より穗に出るまて守る田をかりにのみこそ人は見えけれ",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "秋の田になみよる稻は山河に水ひきうへしさなへなりけり",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "たつねつる心のまゝにいりにけり紅葉の色のふかき山邊に",
   "kana": "",
   "speaker": "",
   "page": 27,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "風吹はそこにくれなゐみちぬめりいかはかりなる山の紅葉そ",
   "kana": "",
   "speaker": "",
   "page": 27,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "しら雲に宿かりかれのきこゆるは旅の空よりゆけはなりけり",
   "kana": "",
   "speaker": "",
   "page": 27,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "をとつれぬたひのなきかなかりかれの行かふ道も遙なれとも",
   "kana": "",
   "speaker": "",
   "page": 27,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "つまこひて秋の夜深く鳴鹿のこゑには人もいやはれらるゝ",
   "kana": "",
   "speaker": "",
   "page": 27,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "いつ方と聞こそわかね小夜更てたちともしらぬ鹿の音なれは",
   "kana": "",
   "speaker": "",
   "page": 27,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
